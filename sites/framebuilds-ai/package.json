{
  "name": "framebuilds-ai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node test/payments.test.cjs && node test/checkout-ui.test.cjs && node test/commerce.test.cjs && node test/payment-result.test.cjs && node test/function-adapter.test.cjs",
    "build": "npm test && python scripts/build_site.py",
    "dev": "node --env-file=.env scripts/dev-server.cjs",
    "test:connection": "node --env-file=.env scripts/check-payment-connection.cjs",
    "check:production": "node --env-file=.env scripts/check-production.cjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.12",
    "@netlify/database": "2.0.4",
    "mercadopago": "3.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0"
  }
}
