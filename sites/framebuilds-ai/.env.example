# Copy to .env. Never commit .env or paste credentials into chat.
# Import the credentials of the automatically managed TEST seller, not the main seller.
MERCADOPAGO_TEST_ACCESS_TOKEN=
MERCADOPAGO_TEST_PUBLIC_KEY=
MERCADOPAGO_TEST_SELLER_ID=
MERCADOPAGO_TEST_APPLICATION_ID=
MERCADOPAGO_TEST_ENABLED=false
# Random 32-byte secret, separate from the provider's webhook signing secret.
MERCADOPAGO_RECEIPT_SECRET=
# From the seller test application's Webhooks page; may remain empty for local checkout.
MERCADOPAGO_WEBHOOK_SECRET=
URL=https://framebuildsai.netlify.app

# Production remains off until all products, account credentials and tests are ready.
MERCADOPAGO_MODE=test
MERCADOPAGO_LIVE_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SELLER_ID=326355222
MERCADOPAGO_ORDER_SECRET=
MERCADOPAGO_PRODUCTION_WEBHOOK_SECRET=
# Netlify Database provisions the hosted URL; supply it explicitly for Lambda compatibility.
NETLIFY_DB_URL=
